PORT=3000
NODE_ENV=development

# Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=yourpassword
PGDATABASE=chamcong

# Authentication Configuration
JWT_ACCESS_SECRET=replace_with_secure_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_TOKEN_HASH_SECRET=replace_with_secure_hash_secret
BCRYPT_SALT_ROUNDS=12

# Timezone Configuration
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Attendance Phase 5 Configuration
MAX_GPS_ACCURACY_METERS=100
REQUIRE_PWA_STANDALONE=false
UPLOAD_DIR=uploads/attendance
MAX_IMAGE_SIZE_MB=5

# Face Recognition Configuration
FACE_SIMILARITY_THRESHOLD=0.82
FACE_MODEL=tensorflow
FACE_MODEL_VERSION=v1
FACE_MIN_SIZE=160
FACE_MAX_COUNT=1
FACE_QUALITY_THRESHOLD=0.75
MEDIAPIPE_MODEL=face_landmarker
MEDIAPIPE_MAX_FACE=1

# Liveness Detection Configuration
LIVENESS_THRESHOLD=0.90
HEAD_POSE_THRESHOLD=20
MAX_FACE_COUNT=1
FACE_QUALITY_THRESHOLD=0.75
ENABLE_EYE_BLINK=true
ENABLE_HEAD_POSE=true
ENABLE_SPOOF_DETECTION=true


