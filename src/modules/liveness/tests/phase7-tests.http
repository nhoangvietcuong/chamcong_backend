# ====================================================================
# BỘ KIỂM THỬ API - GIAI ĐOẠN 7: LIVENESS DETECTION & ANTI-SPOOFING
# ====================================================================

@baseUrl = http://localhost:3000/api
@baseUrlV1 = http://localhost:3000/api/v1
@workDate = 2026-06-30

# ====================================================================
# 0. LOGINS TO ACQUIRE TOKENS & FINGERPRINTS
# ====================================================================

# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-Device-Fingerprint: fingerprint_admin_01

{
  "username": "admin",
  "password": "Admin@123"
}

###
@adminToken = {{adminLogin.response.body.data.accessToken}}
@adminFingerprint = {{adminLogin.response.body.data.deviceFingerprint}}

# @name employee01Login
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-Device-Fingerprint: fingerprint_emp_01

{
  "username": "employee01",
  "password": "Employee@123"
}

###
@emp01Token = {{employee01Login.response.body.data.accessToken}}
@emp01Fingerprint = {{employee01Login.response.body.data.deviceFingerprint}}
@emp01Id = 2

# @name employee02Login
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-Device-Fingerprint: fingerprint_emp_02

{
  "username": "employee02",
  "password": "Employee@123"
}

###
@emp02Token = {{employee02Login.response.body.data.accessToken}}
@emp02Fingerprint = {{employee02Login.response.body.data.deviceFingerprint}}
@emp02Id = 4

# ====================================================================
# 1. SETUP TESTING DATA
# ====================================================================

### 1.1 Create Location (ADMIN)
# @name createLoc
POST {{baseUrl}}/admin/work-locations
Authorization: Bearer {{adminToken}}
X-Device-Fingerprint: {{adminFingerprint}}
Content-Type: application/json

{
  "locationName": "Văn phòng Giai Đoạn 7",
  "address": "123 Liveness St, District 1, HCMC",
  "latitude": 10.776889,
  "longitude": 106.700806,
  "allowedRadiusMeter": 100
}

###
@locId = {{createLoc.response.body.data.locationId}}

### 1.2 Assign Employee 01 Work (ADMIN)
# @name createAssign1
POST {{baseUrl}}/admin/assignments
Authorization: Bearer {{adminToken}}
X-Device-Fingerprint: {{adminFingerprint}}
Content-Type: application/json

{
  "employeeId": {{emp01Id}},
  "locationId": {{locId}},
  "workDate": "{{workDate}}"
}

###
@assign1Id = {{createAssign1.response.body.data.assignmentId}}

### 1.3 Assign Employee 02 Work (ADMIN)
# @name createAssign2
POST {{baseUrl}}/admin/assignments
Authorization: Bearer {{adminToken}}
X-Device-Fingerprint: {{adminFingerprint}}
Content-Type: application/json

{
  "employeeId": {{emp02Id}},
  "locationId": {{locId}},
  "workDate": "{{workDate}}"
}

###
@assign2Id = {{createAssign2.response.body.data.assignmentId}}

# ====================================================================
# 2. STATUS & HEALTH ENDPOINTS (TEST 1-2)
# ====================================================================

### Test 1: Get Liveness status (Authenticated - Employee 01)
GET {{baseUrlV1}}/liveness/status
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}

### Test 2: Get Liveness status without token (Expect: 401 Unauthorized)
GET {{baseUrlV1}}/liveness/status

# ====================================================================
# 3. STANDALONE VERIFICATION ROUTE TESTS (TEST 3-22)
# ====================================================================

### Test 3: Standalone verify - Missing file (Expect: 400 FILE_REQUIRED)
POST {{baseUrlV1}}/liveness/verify
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}
Content-Type: multipart/form-data; boundary=TestBoundary

--TestBoundary
Content-Disposition: form-data; name="employeeId"

{{emp01Id}}
--TestBoundary--

### Test 4: Standalone verify - Missing employeeId (Expect: 400 EMPLOYEE_ID_REQUIRED)
POST {{baseUrlV1}}/liveness/verify
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}
Content-Type: multipart/form-data; boundary=TestBoundary

--TestBoundary
Content-Disposition: form-data; name="photo"; filename="liveness_success.mp4"
Content-Type: video/mp4

< ./scratch/checkin.jpg
--TestBoundary--

