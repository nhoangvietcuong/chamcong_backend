Content-Type: multipart/form-data; boundary=TestBoundary

--TestBoundary
Content-Disposition: form-data; name="employeeId"

3
--TestBoundary
Content-Disposition: form-data; name="photo"; filename="liveness_success.mp4"
Content-Type: video/mp4

< ./scratch/checkin.jpg
--TestBoundary--

