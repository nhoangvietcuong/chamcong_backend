# ====================================================================
# BỘ KIỂM THỬ API - GIAI ĐOẠN 8: DEVICE BIOMETRIC AUTHENTICATION (WebAuthn)
# ====================================================================
#
# LƯU Ý QUAN TRỌNG:
# - WebAuthn yêu cầu trình duyệt thật để tạo chữ ký mật mã (signature).
# - File này kiểm thử toàn bộ logic API: validation, luồng challenge,
#   giới hạn thiết bị, xóa thiết bị, và audit log.
# - Các test đòi hỏi signature thật sẽ trả về lỗi WebAuthn nếu dùng dữ liệu giả.
#   Để test end-to-end đầy đủ, hãy chạy: node scratch/run-phase8-tests.js
#
# THỨ TỰ CHẠY:
# 1. Đảm bảo server đang chạy: npm start
# 2. Chạy login section (Section 0) theo thứ tự
# 3. Chạy setup section (Section 1) theo thứ tự
# 4. Chạy các test theo thứ tự từ trên xuống
# ====================================================================

@baseUrl = http://localhost:3000/api
@baseUrlV1 = http://localhost:3000/api/v1
@workDate = 2026-06-30

# ====================================================================
# 0. LOGINS ĐỂ LẤY TOKENS
# ====================================================================

# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-Device-Fingerprint: fingerprint_admin_01

{
  "username": "admin",
  "password": "Admin@123"
}

###
@adminToken = {{adminLogin.response.body.data.accessToken}}
@adminFingerprint = {{adminLogin.response.body.data.deviceFingerprint}}

# @name employee01Login
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-Device-Fingerprint: fingerprint_emp_01

{
  "username": "employee01",
  "password": "Employee@123"
}

###
@emp01Token = {{employee01Login.response.body.data.accessToken}}
@emp01Fingerprint = {{employee01Login.response.body.data.deviceFingerprint}}
@emp01Id = 2

# @name employee02Login
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-Device-Fingerprint: fingerprint_emp_02

{
  "username": "employee02",
  "password": "Employee@123"
}

###
@emp02Token = {{employee02Login.response.body.data.accessToken}}
@emp02Fingerprint = {{employee02Login.response.body.data.deviceFingerprint}}
@emp02Id = 4

# ====================================================================
# 1. SETUP DỮ LIỆU KIỂM THỬ
# ====================================================================

### 1.1 Tạo Work Location (ADMIN)
# @name createLoc
POST {{baseUrl}}/admin/work-locations
Authorization: Bearer {{adminToken}}
X-Device-Fingerprint: {{adminFingerprint}}
Content-Type: application/json

{
  "locationName": "Văn phòng Giai Đoạn 8",
  "address": "456 WebAuthn Ave, District 3, HCMC",
  "latitude": 10.776889,
  "longitude": 106.700806,
  "allowedRadiusMeter": 100
}

###
@locId = {{createLoc.response.body.data.locationId}}

### 1.2 Giao việc cho Employee 01 (ADMIN)
# @name createAssign1
POST {{baseUrl}}/admin/assignments
Authorization: Bearer {{adminToken}}
X-Device-Fingerprint: {{adminFingerprint}}
Content-Type: application/json

{
  "employeeId": {{emp01Id}},
  "locationId": {{locId}},
  "workDate": "{{workDate}}"
}

###
@assign1Id = {{createAssign1.response.body.data.assignmentId}}

# ====================================================================
# 2. DANH SÁCH THIẾT BỊ (GET CREDENTIALS) — TEST 1-3
# ====================================================================

### Test 1: Lấy danh sách thiết bị - Employee 01 (Expect: 200, mảng rỗng ban đầu)
GET {{baseUrlV1}}/device-biometric/credentials
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}

###

### Test 2: Lấy danh sách thiết bị - không có token (Expect: 401 Unauthorized)
GET {{baseUrlV1}}/device-biometric/credentials

###

### Test 3: Lấy danh sách thiết bị - Employee 02 (Expect: 200, mảng rỗng ban đầu)
GET {{baseUrlV1}}/device-biometric/credentials
Authorization: Bearer {{emp02Token}}
X-Device-Fingerprint: {{emp02Fingerprint}}

###

# ====================================================================
# 3. ĐĂNG KÝ THIẾT BỊ (REGISTRATION FLOW) — TEST 4-11
# ====================================================================

### Test 4: Tạo Registration Options - Employee 01
# (Expect: 200, trả về challenge và publicKeyCredentialCreationOptions)
# @name beginReg01
POST {{baseUrlV1}}/device-biometric/registration/options
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}

###
@regChallenge01 = {{beginReg01.response.body.data.challenge}}

### Test 5: Tạo Registration Options - không có token (Expect: 401 Unauthorized)
POST {{baseUrlV1}}/device-biometric/registration/options

###

### Test 6: Hoàn tất đăng ký - thiếu registrationResponse.id (Expect: 400 VALIDATION_ERROR)
POST {{baseUrlV1}}/device-biometric/registration/verification
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}
Content-Type: application/json

{
  "registrationResponse": {
    "response": {
      "clientDataJSON": "eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIn0",
      "attestationObject": "o2NmbXRkbm9uZQ"
    },
    "type": "public-key"
  },
  "deviceName": "Laptop Cong ty"
}

###

### Test 7: Hoàn tất đăng ký - thiếu trường registrationResponse (Expect: 400 VALIDATION_ERROR)
POST {{baseUrlV1}}/device-biometric/registration/verification
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}
Content-Type: application/json

{
  "deviceName": "My Phone"
}

###

### Test 8: Hoàn tất đăng ký - session không có challenge (Expect: 422 INVALID_CHALLENGE)
POST {{baseUrlV1}}/device-biometric/registration/verification
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: fingerprint_emp_01_no_challenge_session
Content-Type: application/json

{
  "registrationResponse": {
    "id": "mock_credential_id_001",
    "rawId": "mock_credential_id_001",
    "type": "public-key",
    "response": {
      "clientDataJSON": "eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIn0",
      "attestationObject": "o2NmbXRkbm9uZQ"
    }
  },
  "deviceName": "My Phone"
}

###

### Test 9: Hoàn tất đăng ký - chữ ký giả (Expect: lỗi WEBAUTHN_ERROR)
# Gọi Test 4 trước để tạo challenge hợp lệ trong session, rồi chạy test này
POST {{baseUrlV1}}/device-biometric/registration/verification
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}
Content-Type: application/json

{
  "registrationResponse": {
    "id": "mock_credential_id_001",
    "rawId": "mock_credential_id_001",
    "type": "public-key",
    "response": {
      "clientDataJSON": "eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiX19NT0NLX18iLCJvcmlnaW4iOiJodHRwOi8vbG9jYWxob3N0OjMwMDAifQ",
      "attestationObject": "o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YVJBWENLSVQ"
    }
  },
  "deviceName": "My Phone"
}

###

### Test 10: Kiểm tra danh sách thiết bị sau khi đăng ký
GET {{baseUrlV1}}/device-biometric/credentials
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}

###

### Test 11: Đăng ký thiết bị thứ 6 - vượt giới hạn (Expect: 409 MAXIMUM_DEVICE_REACHED)
# Phải đã có đúng 5 thiết bị rồi mới test được case này
# Dùng node scratch/run-phase8-tests.js để seed 5 thiết bị nhanh
POST {{baseUrlV1}}/device-biometric/registration/verification
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}
Content-Type: application/json

{
  "registrationResponse": {
    "id": "sixth_device_attempt_id",
    "rawId": "sixth_device_attempt_id",
    "type": "public-key",
    "response": {
      "clientDataJSON": "eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIn0",
      "attestationObject": "o2NmbXRkbm9uZQ"
    }
  },
  "deviceName": "Thiet bi thu 6 (se bi tu choi)"
}

###

# ====================================================================
# 4. XÓA THIẾT BỊ (DELETE CREDENTIAL) — TEST 12-15
# ====================================================================

### Test 12: Xóa thiết bị - ID không tồn tại (Expect: 404 CREDENTIAL_NOT_FOUND)
DELETE {{baseUrlV1}}/device-biometric/credentials/nonexistent_credential_xyz_999
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}

###

### Test 13: Xóa thiết bị - không có token (Expect: 401 Unauthorized)
DELETE {{baseUrlV1}}/device-biometric/credentials/some_credential_id

###

### Test 14: Xóa thiết bị của người khác (Expect: 403 CREDENTIAL_REVOKED)
# Employee 02 cố xóa thiết bị của Employee 01
DELETE {{baseUrlV1}}/device-biometric/credentials/device_01_id
Authorization: Bearer {{emp02Token}}
X-Device-Fingerprint: {{emp02Fingerprint}}

###

### Test 15: Xóa thiết bị hợp lệ (Expect: 200)
# Thay "device_01_id" bằng credential ID thật lấy từ Test 10
DELETE {{baseUrlV1}}/device-biometric/credentials/device_01_id
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}

###

# ====================================================================
# 5. XÁC THỰC THIẾT BỊ (AUTHENTICATION FLOW) — TEST 16-20
# ====================================================================

### Test 16: Tạo Authentication Options - Employee 01
# (Expect: 200 khi có ít nhất 1 thiết bị; 404 nếu chưa có thiết bị nào)
# @name beginAuth01
POST {{baseUrlV1}}/device-biometric/authentication/options
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}

###
@authChallenge01 = {{beginAuth01.response.body.data.challenge}}

### Test 17: Tạo Authentication Options - không có token (Expect: 401 Unauthorized)
POST {{baseUrlV1}}/device-biometric/authentication/options

###

### Test 18: Hoàn tất xác thực - thiếu trường bắt buộc (Expect: 400 VALIDATION_ERROR)
POST {{baseUrlV1}}/device-biometric/authentication/verification
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}
Content-Type: application/json

{
  "authenticationResponse": {
    "id": "mock_credential_id",
    "type": "public-key",
    "response": {
      "clientDataJSON": "eyJ0eXBlIjoid2ViYXV0aG4uZ2V0In0"
    }
  }
}

###

### Test 19: Hoàn tất xác thực - session không có challenge (Expect: 422 INVALID_CHALLENGE)
POST {{baseUrlV1}}/device-biometric/authentication/verification
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: fingerprint_emp_01_no_auth_challenge
Content-Type: application/json

{
  "authenticationResponse": {
    "id": "some_credential_id",
    "rawId": "some_credential_id",
    "type": "public-key",
    "response": {
      "clientDataJSON": "eyJ0eXBlIjoid2ViYXV0aG4uZ2V0In0",
      "authenticatorData": "SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MAAAAAAA",
      "signature": "FAKE_SIGNATURE_DATA"
    }
  }
}

###

### Test 20: Hoàn tất xác thực - chữ ký giả (Expect: lỗi WEBAUTHN_ERROR)
# Gọi Test 16 trước để tạo challenge, rồi chạy test này
POST {{baseUrlV1}}/device-biometric/authentication/verification
Authorization: Bearer {{emp01Token}}
X-Device-Fingerprint: {{emp01Fingerprint}}
Content-Type: application/json

{
  "authenticationResponse": {
    "id": "device_01_id",
    "rawId": "device_01_id",
    "type": "public-key",
    "response": {
      "clientDataJSON": "eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiX19NT0NLX0NIQUxMRU5HRV9fIiwib3JpZ2luIjoiaHR0cDovL2xvY2FsaG9zdDozMDAwIn0",
      "authenticatorData": "SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MAAAAAAA",
      "signature": "MEQCIAL_FAKE_SIGNATURE_NOT_VALID"
    }
  }
}

###

